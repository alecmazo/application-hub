{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marin-fc-delete",
  "main": "src/index.js",
  "compatibility_date": "2026-11-25",
  "account_id": "e0140ac52d1d8ca60890824b26848e45",
  "workers_dev": true,
  // Secrets (set with `wrangler secret put`, never committed):
  //   DELETE_PASSCODE       — shared passcode Alec chooses
  //   DELETE_GITHUB_TOKEN   — fine-grained PAT: Contents Write + Actions Write on alecmazo/application-hub
  "vars": {
    "REPO": "alecmazo/application-hub",
    "WORKFLOW_FILE": "delete-report.yml",
    "ALLOWED_ORIGIN": "https://alecmazo.github.io"
  }
}
